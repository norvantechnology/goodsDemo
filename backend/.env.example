# GoodsDemo Backend Environment Variables (Render)
NODE_ENV=production
PORT=5000

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/goodsdemo?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
